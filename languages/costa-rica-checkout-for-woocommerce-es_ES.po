#. Plugin Name of the plugin
#: costa-rica-checkout-for-woocommerce.php
#: src/Modules/SinpeMovil/Privacy.php:67
msgid "Costa Rica Checkout for WooCommerce"
msgstr "Costa Rica Checkout for WooCommerce"

#. Description of the plugin
#: costa-rica-checkout-for-woocommerce.php
msgid "SINPE Móvil payments, exchange rates, provinces/cantons/districts and ID numbers for WooCommerce stores in Costa Rica."
msgstr "Pagos con SINPE Móvil, tipo de cambio, provincias/cantones/distritos y número de cédula para tiendas WooCommerce en Costa Rica."

#. Author of the plugin
#: costa-rica-checkout-for-woocommerce.php
msgid "Ariel Orozco"
msgstr "Ariel Orozco"

#: costa-rica-checkout-for-woocommerce.php:36
msgid "Costa Rica Checkout for WooCommerce is missing its autoloader. Run \"composer install\" or install the plugin from its release package."
msgstr "A Costa Rica Checkout for WooCommerce le falta el autocargador. Ejecute \"composer install\" o instale el plugin desde su paquete de distribución."

#: src/Admin/SettingsPage.php:38
msgid "Costa Rica"
msgstr "Costa Rica"

#: src/Admin/SettingsPage.php:50
#: src/Admin/SettingsPage.php:82
msgid "Modules"
msgstr "Módulos"

#: src/Admin/SettingsPage.php:83
msgid "Enable only the features your store needs. Disabled modules add nothing to your store."
msgstr "Active solo las funciones que su tienda necesita. Los módulos desactivados no agregan nada a su tienda."

#: src/Admin/SettingsPage.php:105
msgid "Data"
msgstr "Datos"

#: src/Admin/SettingsPage.php:110
msgid "Delete data on uninstall"
msgstr "Borrar datos al desinstalar"

#: src/Admin/SettingsPage.php:111
msgid "When the plugin is deleted, also delete SINPE Móvil payment receipts and the data this plugin added to orders and customers. Settings are always deleted."
msgstr "Al borrar el plugin, eliminar también los comprobantes de pago de SINPE Móvil y los datos que este plugin agregó a pedidos y clientes. Los ajustes se borran siempre."

