msgid "Exchange rate"
msgstr "Tipo de cambio"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:90
msgid "US dollar rate in colones, used to show the exact amount in colones when your store sells in dollars. It is updated in the background twice a day; customers never wait for it."
msgstr "Tipo de cambio del dólar en colones, usado para mostrar el monto exacto en colones cuando su tienda vende en dólares. Se actualiza en segundo plano dos veces al día; los clientes nunca esperan por él."

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:95
msgid "Current rate"
msgstr "Tipo de cambio actual"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:100
msgid "Source"
msgstr "Fuente"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:107
msgid "BCCR token"
msgstr "Token del BCCR"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:108
msgid "Only for the BCCR source. Generate it in the BCCR economic indicators site, under My profile → Generate token."
msgstr "Solo para la fuente BCCR. Genérelo en el sitio de Indicadores Económicos del BCCR, en Mi perfil → Generar token."

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:113
#: src/Modules/ExchangeRate/ExchangeRateService.php:123
msgid "Manual rate"
msgstr "Tipo de cambio manual"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:114
msgid "Use a fixed rate instead of the automatic source"
msgstr "Usar un tipo de cambio fijo en lugar de la fuente automática"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:120
msgid "Manual rate (₡ per US$)"
msgstr "Tipo de cambio manual (₡ por US$)"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:121
msgid "Used for both buying and selling while the manual rate is on."
msgstr "Se usa tanto para compra como para venta mientras el tipo de cambio manual esté activo."

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:130
msgid "Maximum age (hours)"
msgstr "Antigüedad máxima (horas)"

#: src/Modules/ExchangeRate/ExchangeRateAdmin.php:131
msgid "If the automatic rate is older than this and there is no manual rate, a notice is shown and SINPE Móvil is hidden in stores that do not sell in colones."
msgstr "Si el tipo de cambio automático es más antiguo que esto y no hay tipo de cambio manual, se muestra un aviso y SINPE Móvil se oculta en las tiendas que no venden en colones."

