{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "crkit/exchange-rate",
	"title": "Exchange rate (Costa Rica)",
	"category": "widgets",
	"icon": "money-alt",
	"description": "Shows the US dollar exchange rate in colones stored by Costa Rica Kit for WooCommerce.",
	"keywords": [ "tipo de cambio", "colones", "dólar", "BCCR", "Hacienda" ],
	"textdomain": "costa-rica-kit-for-woocommerce",
	"attributes": {
		"type": {
			"type": "string",
			"enum": [ "both", "sell", "buy" ],
			"default": "both"
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showSource": {
			"type": "boolean",
			"default": true
		},
		"hideOutdated": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"padding": true
		}
	}
}
